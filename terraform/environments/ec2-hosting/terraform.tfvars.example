aws_region   = "eu-west-2"
project_name = "incident-portal"
environment  = "ec2-hosting"

# Replace with your public IP in CIDR form, for example "203.0.113.10/32".
allowed_ssh_cidr = "YOUR_PUBLIC_IP/32"

instance_type = "t3.micro"

# Optional. Set this to an existing EC2 key pair name if you want SSH access.
key_name = null
